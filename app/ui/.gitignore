# Widget Preview related
.widget_preview/

# Bundled engine artifacts, copied at build time (see app/docs/08-engine-api.md):
# - libstrata.so: built by `go build -buildmode=c-shared` (Phase 1, NDK toolchain)
# - seed.db.gz:   generated by app/tools/seedbuild, canonical copy in app/assets/
# Copy them into place before building:
#   cp temp/ffi-build/libstrata.so android/app/src/main/jniLibs/arm64-v8a/
#   cp ../assets/{manifest.json,seed.db.gz} assets/
android/app/src/main/jniLibs/*/libstrata.so
assets/seed.db.gz

